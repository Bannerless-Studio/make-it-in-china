{
  "name": "make-it-in-china",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e:mobile": "node tests/e2e/mobile-touch.mjs",
    "check:content": "node scripts/check-level.mjs content/phase1",
